{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["build/**", "dist/**"]
    },
    "circular": {},
    "clean": {
      "cache": false
    },
    "codegen": {},
    "format": {
      "dependsOn": ["codegen"]
    },
    "lint": {
      "dependsOn": ["codegen"]
    },
    "spellcheck": {},
    "test": {
      "dependsOn": ["codegen", "format", "lint", "spellcheck", "typecheck", "circular"],
      "outputs": ["coverage/**"]
    },
    "typecheck": {
      "dependsOn": ["codegen"]
    },
    "@library/engine#test": {
      "dependsOn": ["@library/dbx#test"]
    },
    "@library/server#test": {
      "dependsOn": ["@library/engine#test"]
    }
  }
}
