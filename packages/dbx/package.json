{
  "name": "@library/dbx",
  "private": true,
  "type": "module",
  "imports": {
    "#~/*": {
      "@library/production": "./dist/*",
      "default": "./src/*"
    }
  },
  "exports": {
    "@library/production": "./dist/index.js",
    "default": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "codegen:kysely": "kysely-codegen --url $DATABASE_URL --dialect postgres --out-file ./src/pg/schema/kysely-generated.ts",
    "lint": "eslint --max-warnings 0 *.js ./src"
  },
  "dependencies": {
    "@library/models": "workspace:*",
    "@library/types": "workspace:*",
    "@library/utils": "workspace:*",
    "kysely": "^0.29.2",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@tools/eslint": "workspace:*",
    "@tools/typescript": "workspace:*",
    "@tools/vitest": "workspace:*",
    "@types/pg": "^8.20.0",
    "kysely-codegen": "^0.20.0",
    "typescript-eslint": "^8.60.1"
  }
}
