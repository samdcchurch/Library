{
  "version": "0.2",
  "language": "en",
  "ignorePaths": [
    "cspell.json",
    "node_modules",
    "dist",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    "docker-compose.yml",
    "coverage"
  ],
  "words": ["samdcchurch", "codegen"],
  "overrides": [
    {
      "filename": "**/tools/eslint/**",
      "words": ["sonarjs"]
    },
    {
      "filename": "**/tools/prettier/**",
      "words": ["packagejson"]
    },
    {
      "filename": "**/packages/dbx/**",
      "words": ["kysely", "psql", "pgcrypto"]
    }
  ]
}
